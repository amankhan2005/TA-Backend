PORT=5001
NODE_ENV=development

# MongoDB Atlas (Africa Cape Town region — af-south-1 for Kenya latency)
MONGODB_URI= 
# JWT
JWT_SECRET=your_super_s 
JWT_EXPIRES_IN=24h

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TeacherAttendance <no-reply@teacherattendance.com>

# Frontend URLs (CORS whitelist)
FRONTEND_SUPER_ADMIN_URL=https://superadmin.teacherattendance.com
FRONTEND_SCHOOL_ADMIN_URL=https://admin.teacherattendance.com

# Token Expiry
INVITE_TOKEN_EXPIRY_HOURS=48
RESET_TOKEN_EXPIRY_MINUTES=30

# Audit Logs
AUDIT_LOG_TTL_DAYS=365

# ── ERP Phase 0+ ──────────────────────────────────────────────────────────
# Redis (job queue for worker.js — notifications, scheduled reports, fee
# reminders, bulk import/export). NOT required by the core API process.
REDIS_URL=redis://localhost:6379

# WhatsApp — Meta WhatsApp Cloud API (confirmed provider)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Student fee currency (independent of the SaaS platform billing price
# above, which stays in whatever currency existing schools were sold in)
FEE_CURRENCY=INR

# Frontend URL for the new Parent Portal (mirrors the existing
# FRONTEND_SUPER_ADMIN_URL / FRONTEND_SCHOOL_ADMIN_URL pattern above)
FRONTEND_PARENT_PORTAL_URL=

# Device API keys (RFID readers / kiosks) are bcrypt-hashed like password
# reset tokens — no extra secret/salt env var needed, consistent with
# utils/token.js's existing generateToken() pattern reused for this.
WORKER_CONCURRENCY=5

# ── ERP Phase 4 — Automated Attendance Reports ──────────────────────────────
# Cron (server-local) for the single daily report sweep in worker.js that
# drives every report schedule. Default 06:00 daily. Standard 5-field cron.
REPORT_SWEEP_CRON=0 6 * * *

# ── F-4 — Notification retry sweep ──────────────────────────────────────────
# Cron for re-attempting failed email/WhatsApp deliveries (worker.js).
NOTIFICATION_RETRY_CRON=*/15 * * * *
# Max delivery attempts before a notification is left terminally failed.
NOTIFICATION_MAX_RETRIES=5

# ── Phase 5 — Fee Management ────────────────────────────────────────────────
# Daily fee reminder sweep (due-soon + overdue).
FEE_REMINDER_CRON=0 7 * * *
FEE_DUE_WINDOW_DAYS=3
FEE_OVERDUE_CADENCE_DAYS=7
# Monthly fee statement generation (1st of month).
FEE_STATEMENT_CRON=0 8 1 * *

# ── Phase 8 — RFID Identity & QR Verification ───────────────────────────────
# Secret for signing student QR tokens (HMAC-SHA256). Falls back to JWT_SECRET.
QR_SIGNING_SECRET=change-me-to-a-long-random-string
# Optional WhatsApp promotion template (Phase 7 notifications).
WHATSAPP_TEMPLATE_PROMOTION=student_promotion_update

# ── Phase 9 — Parent Portal ─────────────────────────────────────────────────
PARENT_MAX_LOGIN_ATTEMPTS=5
PARENT_LOCK_MINUTES=15

# ── Go-live hardening (Final remediation) ───────────────────────────────────
# QR_SIGNING_SECRET is now MANDATORY and MUST differ from JWT_SECRET.
# The app refuses to start if it is missing or equal to JWT_SECRET.
# Base URL of the parent portal frontend, used to build reset/activation links.
PARENT_PORTAL_URL=https://portal.yourschool.example
FRONTEND_URL=https://app.yourschool.example
